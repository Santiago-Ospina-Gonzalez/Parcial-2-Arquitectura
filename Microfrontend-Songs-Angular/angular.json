{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"Microfrontend-Songs-Angular": {
			"projectType": "application",
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"outputPath": "dist/Microfrontend-Songs-Angular",
						"index": "src/index.html",
						"main": "src/main.ts",
						"polyfills": ["zone.js"],
						"tsConfig": "tsconfig.app.json",
						"assets": [{ "glob": "**/*", "input": "public", "output": "." }],
						"styles": ["src/styles.scss", "node_modules/bootstrap/dist/css/bootstrap.min.css"],
						"extraWebpackConfig": "webpack.config.js",
						"commonChunk": false
					},
					"configurations": {
						"production": { "optimization": true, "outputHashing": "all", "extraWebpackConfig": "webpack.prod.config.js" },
						"development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
					},
					"defaultConfiguration": "development"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"development": { "buildTarget": "Microfrontend-Songs-Angular:build:development" },
						"production": { "buildTarget": "Microfrontend-Songs-Angular:build:production" }
					},
					"defaultConfiguration": "development",
					"options": { "port": 4204, "publicHost": "http://localhost:4204", "extraWebpackConfig": "webpack.config.js" }
				},
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"tsConfig": "tsconfig.spec.json",
						"polyfills": ["zone.js", "zone.js/testing"],
						"assets": [{ "glob": "**/*", "input": "public" }],
						"styles": ["src/styles.scss"]
					}
				}
			}
		}
	},
	"cli": { "analytics": false }
}
